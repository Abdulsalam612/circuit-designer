# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# On Vercel, add the same variables under Project → Settings → Environment Variables.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Sentry error reports (src/sentry.shared.ts). Only production builds report.
# DSN: Sentry → Project settings → Client Keys (DSN). It's public, safe in the browser.
NEXT_PUBLIC_SENTRY_DSN=
# For readable stack traces, set these on Vercel only (never commit the token):
# SENTRY_PROJECT = the project's slug; SENTRY_AUTH_TOKEN = Sentry → Settings → Auth Tokens.
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
