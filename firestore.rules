rules_version = '2';

// Firestore security rules for CirKit.
// Each signed-in user can read and write only their own profile (users/{uid}) and their
// own saved circuits (users/{uid}/circuits/{circuitId}); nobody else's.
// Anyone may *add* a feedback message (feedback/{id}); nobody can read, change or delete
// feedback from the site – read it in the Firebase console. Limits match src/lib/feedback.ts.
//
// To apply: Firebase console -> Firestore Database -> Rules, paste this file, Publish.
// (Or with the Firebase CLI: firebase deploy --only firestore:rules)
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /circuits/{circuitId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /feedback/{feedbackId} {
      allow create: if isValidFeedback(request.resource.data);
      allow read, update, delete: if false;
    }

    function optionalString(data, field, maxLength) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLength);
    }

    function isValidFeedback(data) {
      return data.keys().hasOnly(['type', 'message', 'email', 'uid', 'page', 'userAgent', 'createdAt'])
        && data.type in ['bug', 'idea', 'question', 'other']
        && data.message is string && data.message.size() > 0 && data.message.size() <= 2000
        && data.createdAt == request.time
        && optionalString(data, 'email', 200)
        && optionalString(data, 'page', 200)
        && optionalString(data, 'userAgent', 400)
        // A uid may only be your own (signed-out feedback has none)
        && (!('uid' in data) || (request.auth != null && data.uid == request.auth.uid));
    }
  }
}
